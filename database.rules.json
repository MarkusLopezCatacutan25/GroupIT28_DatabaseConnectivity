{
  "rules": {
    ".read": false,
    ".write": false,
    "player_scores": {
      ".indexOn": [
        "score"
      ],
      ".read": "auth != null && query.orderByChild == 'score' && query.limitToLast != null && query.limitToLast > 0 && query.limitToLast <= 10",
      "$score_id": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('owner_uid').val() === auth.uid",
        ".validate": "$score_id.matches(/^slice_[a-f0-9]{32}$/) && newData.hasChildren(['player_name','score','dish_name','level','remarks','created_at','owner_uid'])",
        "player_name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24 && newData.val().matches(/^[a-zA-Z0-9 _\u00f1\u00d1\u00e1\u00e9\u00ed\u00f3\u00fa\u00c1\u00c9\u00cd\u00d3\u00da.-]+$/) && newData.val().matches(/.*[a-zA-Z0-9\u00f1\u00d1\u00e1\u00e9\u00ed\u00f3\u00fa\u00c1\u00c9\u00cd\u00d3\u00da].*/)"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9375 && newData.val() % 1 == 0"
        },
        "dish_name": {
          ".validate": "newData.val() === 'Adobo sa Dilaw'"
        },
        "level": {
          ".validate": "newData.val() === 'Batangas'"
        },
        "remarks": {
          ".validate": "newData.isString() && newData.val().matches(/^batangas_slice_v1 [|] [0-3] stars$/)"
        },
        "created_at": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{7}Z$/)"
        },
        "owner_uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
